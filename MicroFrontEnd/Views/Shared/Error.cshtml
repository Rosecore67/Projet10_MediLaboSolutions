@model ErrorViewModel
@{
    ViewData["Title"] = "Erreur";
}

<div class="text-center mt-5">
    <h1 class="display-4 text-danger">Oups, une erreur s'est produite.</h1>
    <p class="lead">Nous sommes désolés pour ce désagrément.</p>

    <hr />

    @if (Model?.RequestId != null)
    {
        <p>
            <strong>Code de suivi :</strong> <code>@Model.RequestId</code>
        </p>
    }

    <p>Essayez de revenir à l'accueil ou de réessayer plus tard.</p>
    <a class="btn btn-primary mt-3" asp-controller="Home" asp-action="Index">Retour à l'accueil</a>
</div>
