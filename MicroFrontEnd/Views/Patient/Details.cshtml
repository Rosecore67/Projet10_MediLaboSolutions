@model PatientDetailsViewModel

<h2>Détails du Patient</h2>
<table class="table">
    <tr><th>Nom</th><td>@Model.Nom</td></tr>
    <tr><th>Prénom</th><td>@Model.Prenom</td></tr>
    <tr><th>Date de Naissance</th><td>@Model.DateNaissance.ToShortDateString()</td></tr>
    <tr><th>Genre</th><td>@Model.Genre</td></tr>
    <tr><th>Adresse</th><td>@Model.Adresse</td></tr>
    <tr><th>Téléphone</th><td>@Model.Telephone</td></tr>
    <tr><th>Niveau de Risque</th><td>@Model.NiveauRisque</td></tr>
</table>

<h3>Notes du médecin</h3>

@if (Model.Notes != null && Model.Notes.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Contenu</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var note in Model.Notes)
            {
                <tr>
                    <td>@note.Date.ToShortDateString()</td>
                    <td>@note.Content</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Aucune note enregistrée pour ce patient.</p>
}
<a asp-action="Index">Retour à la liste</a>
