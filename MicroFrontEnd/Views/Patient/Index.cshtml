@model List<PatientViewModel>

<h2>Liste des Patients</h2>

<table class="table">
    <thead>
        <tr>
            <th>Nom</th>
            <th>Prénom</th>
            <th>Date de Naissance</th>
            <th>Genre</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var patient in Model)
        {
            <tr>
                <td>@patient.Nom</td>
                <td>@patient.Prenom</td>
                <td>@patient.DateNaissance.ToString("dd/MM/yyyy")</td>
                <td>@patient.Genre</td>
                <td><a asp-action="Details" asp-route-id="@patient.Id">Voir Détails</a></td>
                <td><a asp-action="Edit" asp-route-id="@patient.Id">Modifier</a></td>
                <td>
                    <form asp-action="Delete" asp-route-id="@patient.Id" method="post" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce patient ?');">
                        <button type="submit" class="btn btn-danger">Supprimer</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>